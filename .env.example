# Copia este archivo a .env y completa los valores. .env nunca se sube al
# repositorio (está en .gitignore) — cada máquina/entorno tiene el suyo.

# Cadena de conexión de Postgres (Neon). Usa la variante "pooled" (con
# "-pooler" en el host) — @prisma/adapter-neon está pensado para funcionar
# bien con ella, y es la recomendada para entornos serverless.
# Debe ser una base de datos NUEVA y separada de la de bateria-riesgo-psicosocial.
DATABASE_URL=""

# Clave para firmar las cookies de sesión (HS256). Genera una distinta por
# entorno, por ejemplo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# API key de Anthropic (https://console.anthropic.com) — usada por el motor
# de estandarización (Fase 3) para generar borradores de Perfil a partir de
# las respuestas del Taller. Sin esto, el botón "Generar borrador con IA"
# muestra un error pero el resto de la app funciona normal.
ANTHROPIC_API_KEY=""

# Credenciales de la cuenta y usuario de prueba creados por prisma/seed.ts.
SEED_EMPRESA_NOMBRE="Empresa de Prueba"
SEED_USUARIO_EMAIL=""
SEED_USUARIO_PASSWORD=""
SEED_USUARIO_NOMBRE="Usuario de Prueba"

# API key de Resend (https://resend.com/api-keys) — usada para enviar por
# correo el enlace del Taller de campo a los trabajadores. Sin esto, el envío
# masivo muestra un error pero el resto de la app funciona normal.
RESEND_API_KEY=""

# Remitente de esos correos. Mientras no verifiques un dominio propio en
# Resend, solo puedes usar "onboarding@resend.dev" y solo llegan al correo con
# el que creaste la cuenta de Resend — verifica un dominio para enviar a
# cualquier trabajador de verdad.
RESEND_FROM_EMAIL="OGP <onboarding@resend.dev>"
